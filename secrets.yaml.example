# Copy to secrets.yaml and fill in.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"

# Fallback access point (shown on the panel when Wi-Fi can't connect). Min. 8 characters.
ap_password: "zvv-setup"

# Generate with: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
